        handle CDATA #IMPLIED
        dimension CDATA #IMPLIED
        name CDATA #REQUIRED>
    <!ELEMENT param (#PCDATA)>
    <!ATTLIST param
        value CDATA #REQUIRED
        index CDATA #IMPLIED
        name CDATA #REQUIRED>
    ]>
